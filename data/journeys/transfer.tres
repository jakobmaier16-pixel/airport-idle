[gd_resource type="Resource" script_class="JourneyRecipe" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/journey_recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/resources/journey_step.gd" id="2_step"]

[sub_resource type="Resource" id="s_transfer"]
script = ExtResource("2_step")
role = 8
holds_flight = true
emerges_behind = true

[sub_resource type="Resource" id="s_gate"]
script = ExtResource("2_step")
role = 4
detour_before = true
detour_lounge = true
holds_flight = true

[resource]
script = ExtResource("1_recipe")
id = &"transfer"
steps = Array[ExtResource("2_step")]([SubResource("s_transfer"), SubResource("s_gate")])
