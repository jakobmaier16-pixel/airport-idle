[gd_resource type="Resource" script_class="JourneyRecipe" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/journey_recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/resources/journey_step.gd" id="2_step"]

[sub_resource type="Resource" id="s_check_in"]
script = ExtResource("2_step")
role = 2

[sub_resource type="Resource" id="s_security"]
script = ExtResource("2_step")
role = 3
detour_before = true
detour_allowance = 60.0
detour_chance_factor = 0.4
emerges_behind = true

[sub_resource type="Resource" id="s_gate"]
script = ExtResource("2_step")
role = 4
detour_before = true
detour_lounge = true
holds_flight = true

[resource]
script = ExtResource("1_recipe")
id = &"departure"
steps = Array[ExtResource("2_step")]([SubResource("s_check_in"), SubResource("s_security"), SubResource("s_gate")])
